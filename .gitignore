# ==============================================================================
#  fc-emulator — 忽略规则
#
#  原则：只把「源码 + 文档 + 构建脚本」放进版本库。
#        第三方二进制、ROM/存档、本机个人配置、编译产物、调试截图一律排除。
# ==============================================================================

# ------------------------------------------------------------------------------
# 一、第三方依赖（体积大，且有自己的许可证，不入库）
#      恢复办法见 README「前置条件」：把 SDL2-devel-2.30.9-mingw.tar.gz
#      解压后放到 third_party/SDL2-2.30.9/，或改用 -DFC_SDL2_ROOT=<目录>
# ------------------------------------------------------------------------------
/third_party/

# ------------------------------------------------------------------------------
# 二、ROM 与存档 —— 版权 / 个人数据，绝不入库
#      游戏 ROM 受版权保护；存档（.fcstate）是个人游玩进度，且体积大。
# ------------------------------------------------------------------------------
*.nes
*.fds
*.unf
*.unif
*.nsf
*.fcstate
!roms/README.md

# ------------------------------------------------------------------------------
# 三、本机个人配置 —— 每人一套键位，不该互相覆盖
# ------------------------------------------------------------------------------
fc-keys.cfg
*.keymap
.env
.env.*
*.secret
secrets.*

# ------------------------------------------------------------------------------
# 四、构建目录与编译产物
# ------------------------------------------------------------------------------
/build/
build-*/
# 从 zip 里读 ROM 时解包出来的临时缓存（内容就是 ROM 本体，同样受版权保护）
# 默认落在 exe 同级目录，构建目录整个忽略时已在里面，这里是防止 out-of-tree 构建时漏网
/romcache/
romcache/
build.zip
*.o
*.obj
*.lo
*.a
*.lib
*.dll
*.exe
*.so
*.so.*
*.dylib
*.pdb
*.ilk
*.idb
*.exp
*.res
*.out

# CMake 生成物（build 目录已整体忽略，这里是防止在别处做 out-of-tree 构建时漏网）
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
ctest/
Testing/
compile_commands.json
*.ninja
.ninja_deps
.ninja_log

# ------------------------------------------------------------------------------
# 五、调试 / 验证过程产生的临时文件
#      （--shot 界面截图、--dump-ppu 显存导出、逐帧哈希日志、调试分段目录等）
# ------------------------------------------------------------------------------
*.ppm
*.png
*.bmp
*.tga
shot.*
_dbg*/
_dbg*
*.log
_*.txt
*.tmp
*.bak
*.orig
*.rej

# 例外：文档里要展示的界面截图。它们是用 `--shot` 生成后挑出来单独存的，
# 属于文档资产而不是调试垃圾，所以要入库。
!docs/screenshots/
!docs/screenshots/*.png

# ------------------------------------------------------------------------------
# 六、编辑器 / IDE / 操作系统垃圾
#      .vscode 里存的是本机绝对路径，换台机器就是错的，所以也不入库
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.clangd/
.cache/
compile_flags.txt
Thumbs.db
desktop.ini
.DS_Store
